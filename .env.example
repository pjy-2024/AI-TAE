# ===== AI-TAE 环境变量示例 =====
# 用法：复制本文件为 .env 后填写真实值（.env 已被 gitignore，不会入库）。
# LLM 走 OpenAI 兼容接口：DeepSeek / Qwen 均可，只需改 base_url + model。

# API Key（必填，真实调用前）
AITAE_LLM_API_KEY=sk-你的key
# DeepSeek: https://api.deepseek.com
# Qwen(通义): https://dashscope.aliyuncs.com/compatible-mode/v1
AITAE_LLM_BASE_URL=https://api.deepseek.com
AITAE_LLM_MODEL=deepseek-chat

# 网络与重试
AITAE_LLM_TIMEOUT_SECONDS=60
AITAE_LLM_MAX_RETRIES=3
AITAE_LLM_TEMPERATURE=0.0
AITAE_LLM_JSON_MODE=true

# 被测项目服务地址（V1 执行阶段用）
AITAE_TARGET_BASE_URL=http://127.0.0.1:8000